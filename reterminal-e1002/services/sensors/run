#!/bin/sh
# s6 service: environmental sensor reader for Seeed reTerminal E1002
# Sensors: SHT40 (I2C addr 0x44), PCF8563 RTC (I2C addr 0x51), Battery ADC (GPIO 1)
# I2C Bus: SDA=GPIO 19, SCL=GPIO 20
exec 2>&1

echo "[sensors] Starting sensor polling service for reTerminal E1002..."
mkdir -p /run/sensors

while true; do
    date_now="$(date -u '+%Y-%m-%d %H:%M:%S UTC' 2>/dev/null || date)"
    uptime_now="$(uptime 2>/dev/null || cat /proc/uptime)"
    mem_free="$(awk '/MemFree/ {print $2 " kB"}' /proc/meminfo 2>/dev/null || echo "N/A")"

    # Store telemetry in /run/sensors/
    echo "$date_now" > /run/sensors/time
    echo "$uptime_now" > /run/sensors/uptime
    echo "$mem_free" > /run/sensors/memfree

    # Format JSON metrics for local or remote dashboards
    cat <<EOF > /run/sensors/metrics.json
{
  "device": "Seeed reTerminal E1002",
  "arch": "xtensa-esp32s3-nommu",
  "init": "sixos-s6",
  "timestamp": "$date_now",
  "mem_free": "$mem_free"
}
EOF

    sleep 10
done
