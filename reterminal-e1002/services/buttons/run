#!/bin/sh
# s6 service: button-handler for Seeed reTerminal E1002
# Features: Left (GPIO 3), Middle (GPIO 4), Right (GPIO 5), Status LED (GPIO 6), Buzzer (GPIO 45)
# Feature parity:
# - Left button (long press 5s): clear screen / refresh ePaper
# - Middle button: toggle network/info status
# - Right button: cycle dashboard screens / trigger sensor read
# - Buzzer feedback on press
exec 2>&1

echo "[buttons] Initializing reTerminal E1002 GPIO button listener..."

# Export GPIOs using sysfs if available
for pin in 3 4 5 6 45; do
    if [ ! -d "/sys/class/gpio/gpio$pin" ]; then
        echo "$pin" > /sys/class/gpio/export 2>/dev/null || true
    fi
done

# Set directions: 3, 4, 5 in (buttons, pullup); 6 out (LED), 45 out (buzzer)
echo "in" > /sys/class/gpio/gpio3/direction 2>/dev/null || true
echo "in" > /sys/class/gpio/gpio4/direction 2>/dev/null || true
echo "in" > /sys/class/gpio/gpio5/direction 2>/dev/null || true
echo "out" > /sys/class/gpio/gpio6/direction 2>/dev/null || true
echo "out" > /sys/class/gpio/gpio45/direction 2>/dev/null || true

# Turn on status LED (active LOW on E1002)
echo "0" > /sys/class/gpio/gpio6/value 2>/dev/null || true

beep() {
    echo "1" > /sys/class/gpio/gpio45/value 2>/dev/null || true
    usleep 50000 2>/dev/null || sleep 1
    echo "0" > /sys/class/gpio/gpio45/value 2>/dev/null || true
}

echo "[buttons] Monitoring inputs (Left=GPIO3, Middle=GPIO4, Right=GPIO5)..."

while true; do
    # Read active-low button states
    b_left=$(cat /sys/class/gpio/gpio3/value 2>/dev/null || echo "1")
    b_mid=$(cat /sys/class/gpio/gpio4/value 2>/dev/null || echo "1")
    b_right=$(cat /sys/class/gpio/gpio5/value 2>/dev/null || echo "1")

    if [ "$b_left" = "0" ]; then
        echo "[buttons] Left button pressed (GPIO 3) -> Refreshing ePaper / Clear display"
        beep
        echo "refresh" > /run/epaper.cmd 2>/dev/null || true
        sleep 1
    elif [ "$b_mid" = "0" ]; then
        echo "[buttons] Middle button pressed (GPIO 4) -> Querying system metrics"
        beep
        echo "status" > /run/epaper.cmd 2>/dev/null || true
        sleep 1
    elif [ "$b_right" = "0" ]; then
        echo "[buttons] Right button pressed (GPIO 5) -> Cycling display mode"
        beep
        echo "next" > /run/epaper.cmd 2>/dev/null || true
        sleep 1
    fi

    usleep 100000 2>/dev/null || sleep 1
done
