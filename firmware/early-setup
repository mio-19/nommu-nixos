#!/bin/sh
set -eu
system=/nix/var/nix/profiles/system
export PATH="/run/current-system/bin:$system/bin:$system/sw/bin:$system/sw/sbin:$system/sw/usr/bin:$system/sw/usr/sbin"
# Match the mounts the upstream BusyBox init performed before rcS.
mount -t proc proc /proc
mkdir -p /dev/pts /dev/shm /tmp /run/lock/subsys
mount -t devpts -o gid=5,mode=620,ptmxmode=0666 devpts /dev/pts
mount -t tmpfs -o mode=0777 tmpfs /dev/shm
mount -t tmpfs -o mode=1777 tmpfs /tmp
mount -t sysfs sysfs /sys
mount -t jffs2 mtd:etc /etc
mount -t jffs2 mtd:home /home
ln -sf /proc/self/fd /dev/fd
ln -sf /proc/self/fd/0 /dev/stdin
ln -sf /proc/self/fd/1 /dev/stdout
ln -sf /proc/self/fd/2 /dev/stderr
# BusyBox passwd also rewrites passwd when updating shadow. Seed writable
# identity files atomically so first-login provisioning continues to work.
for name in passwd group; do
  cp "/run/current-system/etc/$name" "/etc/$name.sixos-new"
  chmod 644 "/etc/$name.sixos-new"
  mv -f "/etc/$name.sixos-new" "/etc/$name"
done
for name in hosts hostname os-release issue shells profile nsswitch.conf; do
  if [ -e "/run/current-system/etc/$name" ]; then
    ln -sf "/run/current-system/etc/$name" "/etc/$name"
  fi
done
mkdir -p /home/root /etc/profile.d
printf '%s\n' 'export PATH="/run/current-system/bin:/run/current-system/sw/bin:/run/current-system/sw/sbin:/run/current-system/sw/usr/bin:/run/current-system/sw/usr/sbin"' > /etc/profile.d/sixos.sh
hostname -F /etc/hostname
