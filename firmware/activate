#!/bin/sh
set -eu
system=/nix/var/nix/profiles/system
export PATH="/run/current-system/bin:$system/bin:$system/sw/bin:$system/sw/sbin:$system/sw/usr/bin:$system/sw/usr/sbin"
mkdir -p /run/lock /run/service
ln -sfn "$system" /run/current-system
ln -sfn "$system" /run/system
ln -sfn /run/current-system/six/target /run/target
if test -d /run/s6-rc; then
  # The active configuration cannot change on immutable cramfs. Reassert its
  # default bundle without replacing live servicedirs (unsupported by the
  # current NOMMU kernel). Upgrades are installed by flashing and rebooting.
  exec "$system/bin/s6-rc" -v2 -up change default
fi
ln -sfn "$system" /run/booted-system
"$system/bin/s6-rc-init" -d -c "$system/six/s6-rc/db" /run/service
exec "$system/bin/s6-rc" -v2 -up change default
